generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Customer {
  id         String  @id
  name       String
  type       String
  city       String
  department String?
  since      String?
  contact    String?
  email      String?
  phone      String?
  address    String?

  orders   Order[]
  followUp FollowUp?
}

model Order {
  id          String   @id
  reference   String   @unique
  date        String
  amountCents Int
  status      String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

// Un suivi par client au plus
model FollowUp {
  customerId String   @id
  status     String
  note       String?
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
}
